flowchart TB
    User([User]) --> HTML["index.html\nApp shell"]

    subgraph App["ES Modules"]
        HTML --> app["app.js\nEntry point"]
        app --> state["state.js\nRoster, weeks, meetings, settings + localStorage"]
        app --> render["render.js\nWeek tabs, chips, board, puzzle blocks, bottle wall"]
        app --> events["events.js\nPointer drag + keyboard seating, meeting CRUD"]
        events --> data["data.js\nMeeting types, presets, recurrence weights"]
        render --> load["load.js\nWeighted hours — per-week + avg"]
        render --> insights["insights.js\nPer-week overload / duplicate / oversized flags"]
        load --> data
        insights --> load
        app --> utils["utils.js\ngenId, escHtml, debounce, toast"]
    end

    state <-->|"loadout-v1"| Storage[("localStorage")]
